<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.igirepay.controller.LoginController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label text="IgirePay" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Sign in with your account"/>

    <Label text="Account number"/>
    <TextField fx:id="accountIdField" promptText="e.g. 1"/>

    <Label text="PIN"/>
    <PasswordField fx:id="pinField" promptText="4-digit PIN"/>

    <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>

    <Button text="Login" onAction="#onLoginClick" defaultButton="true"/>

    <Label wrapText="true" style="-fx-font-size: 11px;"
           text="Try: Account 1, PIN 1234 (John's wallet)&#10;Account 2, PIN 1234 (John's savings)&#10;Account 3, PIN 5678 (Mary's wallet)"/>
</VBox>
